# AI4Science .env — скопируй в .env и заполни своими значениями.
# Мастер cli/wizard.py делает это автоматически при установке.

# === бекенд инференса (OpenAI-совместимый шлюз) ===
KEY=YOUR_API_KEY_HERE
ENDPOINT=https://YOUR_GATEWAY_HOST/v1
MODEL=ai-pro

# Модель для /plan; off — отключить отдельную модель планирования.
PLANNER_MODEL=off

# === Lean checker ===
# По умолчанию — удалённый сервис курса. Локальный вариант:
# ./setup.sh --with-lean-local и LEAN_CHECKER_URL=http://localhost:8888
LEAN_CHECKER_URL=https://scilibai.ru/grag

# === Необязательно ===
# BRAVE_API_KEY=                     # поиск через Brave вместо DuckDuckGo
# GOOSE_CONTEXT_LIMIT=128000
# GOOSE_AUTO_COMPACT_THRESHOLD=0.8
# GOOSE_MAX_TOKENS=16000
# GOOSE_TEMPERATURE=0.2
